THEOS = /opt/theos

// This fork targets standard rootless jailbreaks (Dopamine/Fugu15-style).
POP_SCHEME = rootless
POP_ROOTHIDE_LDFLAGS =
POP_ROOTLESS_LDFLAGS =

SDKROOT = iphoneos
TARGETED_DEVICE_FAMILY = 1,2
IPHONEOS_DEPLOYMENT_TARGET = 14.0
ARCHS = arm64 arm64e
VALID_ARCHS = arm64 arm64e
ONLY_ACTIVE_ARCH = NO
ENABLE_BITCODE = NO
CLANG_ENABLE_OBJC_ARC = YES
ALWAYS_SEARCH_USER_PATHS = NO
GCC_PRECOMPILE_PREFIX_HEADER = YES
VERSIONING_SYSTEM = apple-generic
DYLIB_COMPATIBILITY_VERSION = 1
DYLIB_CURRENT_VERSION = 1

// Injected binaries are ad-hoc signed by ldid in the workflow.
CODE_SIGN_IDENTITY =
CODE_SIGN_IDENTITY[sdk=iphoneos*] =
CODE_SIGNING_REQUIRED = NO
CODE_SIGNING_ALLOWED = NO
CODE_SIGN_STYLE = Manual
DEVELOPMENT_TEAM =
PROVISIONING_PROFILE_SPECIFIER =
AD_HOC_CODE_SIGNING_ALLOWED = YES

HEADER_SEARCH_PATHS = $(inherited) $(THEOS)/vendor/include $(THEOS)/include $(SRCROOT)/ThirdParty/L360Confetti/iOS
FRAMEWORK_SEARCH_PATHS = $(inherited) $(THEOS)/vendor/lib/iphone $(THEOS)/vendor/lib
LIBRARY_SEARCH_PATHS = $(inherited) $(THEOS)/vendor/lib/iphone $(THEOS)/vendor/lib

POP_SCHEME_DEFS = POP_PACKAGE_SCHEME_ROOTLESS=1
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) $(POP_SCHEME_DEFS)

// Private iOS framework symbols are resolved by the jailbreak loader.
OTHER_LDFLAGS = $(inherited) -undefined dynamic_lookup

GCC_GENERATE_DEBUGGING_SYMBOLS = NO
GCC_SYMBOLS_PRIVATE_EXTERN = YES
DEPLOYMENT_POSTPROCESSING = YES
STRIP_INSTALLED_PRODUCT = YES
STRIP_STYLE = non-global
COPY_PHASE_STRIP = NO
DEAD_CODE_STRIPPING = YES
