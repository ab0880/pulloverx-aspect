@@ -5,23 +5,19 @@
 
 #import <Foundation/Foundation.h>
 
-#if defined(THEOS_PACKAGE_SCHEME_ROOTHIDE)
-#import <roothide.h>
-#elif defined(POP_PACKAGE_SCHEME_ROOTLESS)
-#import <rootless.h>
